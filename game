<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MGOT Civilization Builder</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#020617;
    color:white;
    min-height:100vh;
    padding:20px;
}

.container{
    max-width:1000px;
    margin:auto;
}

h1{
    text-align:center;
    margin-bottom:20px;
    color:#22d3ee;
}

.topbar{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-bottom:20px;
}

.resource{
    background:#0f172a;
    padding:15px;
    border-radius:12px;
    text-align:center;
    border:1px solid #1e293b;
}

.resource span{
    display:block;
    margin-top:5px;
    font-size:24px;
    font-weight:bold;
}

.era-box{
    background:#0f172a;
    padding:20px;
    border-radius:12px;
    margin-bottom:20px;
    text-align:center;
    border:1px solid #1e293b;
}

.era-name{
    color:#22d3ee;
    font-size:28px;
    margin-top:10px;
}

.game{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.panel{
    background:#0f172a;
    padding:20px;
    border-radius:12px;
    border:1px solid #1e293b;
}

.panel h2{
    margin-bottom:15px;
    color:#22d3ee;
}

button{
    width:100%;
    padding:14px;
    margin-bottom:10px;
    border:none;
    border-radius:10px;
    background:#0891b2;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:.2s;
}

button:hover{
    transform:scale(1.02);
}

.building{
    margin-bottom:15px;
    padding:12px;
    border-radius:10px;
    background:#111827;
}

.footer{
    margin-top:20px;
    text-align:center;
    color:#94a3b8;
}

@media(max-width:768px){
    .game{
        grid-template-columns:1fr;
    }

    .topbar{
        grid-template-columns:1fr;
    }
}
</style>
</head>
<body>

<div class="container">

<h1>🧠 MGOT Civilization Builder</h1>

<div class="topbar">
    <div class="resource">
        Knowledge
        <span id="knowledge">0</span>
    </div>

    <div class="resource">
        Energy
        <span id="energy">0</span>
    </div>

    <div class="resource">
        Community
        <span id="community">0</span>
    </div>
</div>

<div class="era-box">
    <div>Current Era</div>
    <div class="era-name" id="era">🧍 Individual</div>
</div>

<div class="game">

<div class="panel">

<h2>Actions</h2>

<button onclick="study()">📚 Study (+1 Knowledge)</button>

<button onclick="exercise()">💪 Exercise (+1 Energy)</button>

<button onclick="network()">🤝 Network (+1 Community)</button>

</div>

<div class="panel">

<h2>Buildings</h2>

<div class="building">
    📚 Learning Center<br>
    Cost: 50 Knowledge<br>
    +1 Knowledge/sec<br><br>
    <button onclick="buyLearning()">Buy</button>
</div>

<div class="building">
    💪 Gym<br>
    Cost: 50 Energy<br>
    +1 Energy/sec<br><br>
    <button onclick="buyGym()">Buy</button>
</div>

<div class="building">
    🤝 Community Hub<br>
    Cost: 50 Community<br>
    +1 Community/sec<br><br>
    <button onclick="buyCommunity()">Buy</button>
</div>

</div>

</div>

<div class="footer">
    MGOT Civilization Builder v1.0
</div>

</div>

<script>

let knowledge = 0;
let energy = 0;
let community = 0;

let learningCenters = 0;
let gyms = 0;
let communityHubs = 0;

function updateUI(){

document.getElementById("knowledge").textContent =
Math.floor(knowledge);

document.getElementById("energy").textContent =
Math.floor(energy);

document.getElementById("community").textContent =
Math.floor(community);

let era = "🧍 Individual";

if(
knowledge >= 100 &&
energy >= 100 &&
community >= 100
){
era = "👥 Tribe";
}

if(
knowledge >= 500 &&
energy >= 500 &&
community >= 500
){
era = "🏫 Academy";
}

if(
knowledge >= 2500 &&
energy >= 2500 &&
community >= 2500
){
era = "🏙️ City";
}

if(
knowledge >= 10000 &&
energy >= 10000 &&
community >= 10000
){
era = "🌍 Global Network";
}

document.getElementById("era").textContent = era;

saveGame();
}

function study(){
knowledge++;
updateUI();
}

function exercise(){
energy++;
updateUI();
}

function network(){
community++;
updateUI();
}

function buyLearning(){

if(knowledge >= 50){
knowledge -= 50;
learningCenters++;
updateUI();
}
}

function buyGym(){

if(energy >= 50){
energy -= 50;
gyms++;
updateUI();
}
}

function buyCommunity(){

if(community >= 50){
community -= 50;
communityHubs++;
updateUI();
}
}

setInterval(()=>{

knowledge += learningCenters;
energy += gyms;
community += communityHubs;

updateUI();

},1000);

function saveGame(){

const data = {
knowledge,
energy,
community,
learningCenters,
gyms,
communityHubs
};

localStorage.setItem(
"mgot_save",
JSON.stringify(data)
);

}

function loadGame(){

const save =
localStorage.getItem("mgot_save");

if(!save) return;

const data = JSON.parse(save);

knowledge = data.knowledge || 0;
energy = data.energy || 0;
community = data.community || 0;

learningCenters = data.learningCenters || 0;
gyms = data.gyms || 0;
communityHubs = data.communityHubs || 0;

}

loadGame();
updateUI();

</script>

</body>
</html>
